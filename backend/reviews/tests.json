{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET список отзывов",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "bodyMatcher": "partial",
      "expectedBody": {
        "reviews": []
      }
    },
    {
      "name": "POST без обязательных полей",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "POST с корректными данными",
      "method": "POST",
      "path": "/",
      "body": {
        "name": "Тестовый пользователь",
        "rating": 5,
        "text": "Отличный сервис, спасибо!"
      },
      "expectedStatus": 200,
      "bodyMatcher": "partial",
      "expectedBody": {
        "success": true
      }
    }
  ]
}
